$escape = $this->plugin('escapeHtml');
?>
<article class="section-card">
    <div class="badge-row" style="margin-bottom:0.75rem;">
        <span class="badge badge-context"><?= $escape((string) $item->value('dcterms:type', ['default' => 'Archival Photograph'])) ?></span>
        <span class="badge" style="background:#eef5fb;color:#072a47;"><?= $escape((string) $item->value('dcterms:temporal', ['default' => ''])) ?></span>
